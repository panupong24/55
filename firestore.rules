rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == '684234020@parichat.skru.ac.th')
      );
    }

    // Admins registry
    match /admins/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.auth.uid == uid && request.auth.token.email != null && request.auth.token.email.lower() == '684234020@parichat.skru.ac.th') ||
        isAdmin()
      );
    }

    // Community reviews
    match /reviews/{reviewId} {
      // Public can read visible reviews; admin can read all including hidden
      allow read: if resource == null || resource.data.hidden != true || isAdmin();
      
      // Anyone can submit a review with valid fields
      allow create: if request.resource.data.rating is number &&
                      request.resource.data.rating >= 1 &&
                      request.resource.data.rating <= 5 &&
                      request.resource.data.comment is string &&
                      request.resource.data.comment.size() > 0 &&
                      request.resource.data.comment.size() <= 280 &&
                      request.resource.data.userName is string &&
                      request.resource.data.createdAt is number;

      // Anyone can flag as reported, or Admin can update status/hidden
      allow update: if (isAdmin()) || 
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported']) && 
                       request.resource.data.reported == true);

      // Only admins can delete reviews
      allow delete: if isAdmin();
    }

    // Reports and feedback
    match /reports/{reportId} {
      // Only authenticated admins can view reports
      allow read: if isAdmin();

      // Anyone can create a report with valid category and details
      allow create: if request.resource.data.category in ['bug', 'translation', 'inappropriate_comment', 'suggestion'] &&
                      request.resource.data.details is string &&
                      request.resource.data.details.size() > 0 &&
                      request.resource.data.details.size() <= 500 &&
                      request.resource.data.status in ['new', 'investigating', 'resolved'] &&
                      request.resource.data.createdAt is number;

      // Only admins can update status or delete reports
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
