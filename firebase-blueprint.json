{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator account metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "role"]
    },
    "Review": {
      "title": "Review",
      "description": "User feedback and rating for the quiz",
      "type": "object",
      "properties": {
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 280 },
        "userName": { "type": "string" },
        "percentage": { "type": "number" },
        "tierBadge": { "type": "string" },
        "createdAt": { "type": "number" },
        "reported": { "type": "boolean" },
        "hidden": { "type": "boolean" }
      },
      "required": ["rating", "comment", "userName", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User problem report or feedback",
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["bug", "translation", "inappropriate_comment", "suggestion"]
        },
        "details": { "type": "string", "maxLength": 500 },
        "targetCommentId": { "type": "string" },
        "targetCommentSnippet": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["new", "investigating", "resolved"]
        },
        "createdAt": { "type": "number" },
        "lang": { "type": "string" }
      },
      "required": ["category", "details", "status", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized administrators list"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Community reviews collection"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Issue reports and suggestions collection"
    }
  }
}
